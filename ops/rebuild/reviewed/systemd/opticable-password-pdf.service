[Unit]
Description=Password PDF Generator API
After=network.target

[Service]
User=opticable-password-pdf
Group=opticable-password-pdf
WorkingDirectory=/opt/opticable-api-platform/apps/password-pdf-service
EnvironmentFile=/etc/opticable-password-pdf.env
Environment=WIFI_PDF_CONFIG_PATH=/etc/opticable-password-pdf/brand_settings.json
Environment=PATH=/opt/opticable-api-platform/apps/password-pdf-service/.venv/bin
ExecStart=/opt/opticable-api-platform/apps/password-pdf-service/.venv/bin/uvicorn wifi_pdf.api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
