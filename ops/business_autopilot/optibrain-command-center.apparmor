# Exact application confinement. Not a monitor permission expansion.
# SQLite DELETE journaling needs its canonical parent for sidecar creation;
# this mandatory profile denies every other current or future sibling write.
profile optibrain-command-center-v1 flags=(attach_disconnected) {
  /** r,
  /usr/** mr,
  /lib/** mr,
  /lib64/** mr,
  /opt/optibrain-releases/** mr,
  /opt/opticable-api-platform/** mr,
  /usr/bin/python3.12 ix,
  /dev/null rw,
  /dev/urandom r,
  /dev/random r,
  /var/lib/opticable-workflow-api/output/automation/phase12-autonomy.db rwk,
  /var/lib/opticable-workflow-api/output/automation/phase12-autonomy.db-journal rw,
  /var/lib/opticable-workflow-api/output/automation/phase12-autonomy.db-wal rw,
  /var/lib/opticable-workflow-api/output/automation/phase12-autonomy.db-shm rwk,
  deny /proc/*/environ r,
  deny /etc/opticable-workflow-api.env r,
  deny /etc/optibrain/github-app.pem r,
  deny /etc/optibrain/r2-uploader.env r,
  deny /var/lib/opticable-workflow-api/output/automation/*access-cache* r,
  deny /var/lib/opticable-workflow-api/output/automation/*credentials* r,
  deny /var/lib/opticable-workflow-api/output/automation/business-autopilot/owner-review-access.json r,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  signal (receive) peer=unconfined,
  signal (send,receive) peer=optibrain-command-center-v1,
  ptrace (readby) peer=unconfined,
}
