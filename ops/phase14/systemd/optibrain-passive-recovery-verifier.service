[Unit]
Description=OptiBrain passive independent recovery runtime verification only
After=local-fs.target
[Service]
Type=oneshot
User=nobody
Group=nogroup
UMask=0077
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/optibrain-recovery/passive_child.py
TimeoutStartSec=20
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StandardOutput=truncate:/var/lib/optibrain/autonomous-operations/passive-recovery/runtime-result.json
StandardError=journal
