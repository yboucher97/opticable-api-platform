[Unit]
Description=Independent OLD migration fence supervision, never starts business writers
After=network-online.target
OnFailure=optibrain-migration-source-alert.service
[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=optibrain-migration-watchdog
RuntimeDirectoryMode=0700
ExecStart=/opt/opticable-api-platform/apps/workflow-api/.venv/bin/python -B /usr/local/lib/optibrain-migration/source_executor.py supervise
TimeoutStartSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/optibrain-migration-source /run/optibrain-migration-watchdog
PrivateTmp=true
