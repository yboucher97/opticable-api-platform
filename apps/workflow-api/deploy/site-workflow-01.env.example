SITE_WORKFLOW_API_KEY=replace-with-a-long-random-secret
SITE_WORKFLOW_HOST=127.0.0.1
SITE_WORKFLOW_PORT=8100
SITE_WORKFLOW_OUTPUT_ROOT=/var/lib/site-workflow-01/output
SITE_WORKFLOW_SSID_PREFIX=APT_
SITE_WORKFLOW_SSID_TEMPLATE={prefix}{identifier}_{suffix}
SITE_WORKFLOW_SSID_SUFFIX_LENGTH=2
SITE_WORKFLOW_PASSWORD_SPECIALS=*!$@#

PASSWORD_PDF_BASE_URL=http://127.0.0.1:8000
PASSWORD_PDF_API_KEY=replace-with-password-pdf-api-key
PASSWORD_PDF_TIMEOUT_SECONDS=600

OMADA_SITE_CREATOR_BASE_URL=http://127.0.0.1:3210
OMADA_SITE_CREATOR_WEBHOOK_TOKEN=replace-with-omada-webhook-token
OMADA_SITE_CREATOR_TIMEOUT_SECONDS=900

OMADA_ORGANIZATION_NAME=Opti-plex
OMADA_CLOUD_BASE_URL=https://use1-omada-cloud.tplinkcloud.com/
OMADA_BROWSER_CHANNEL=chromium
OMADA_HEADLESS=true
OMADA_DEFAULT_REGION=Canada
OMADA_DEFAULT_TIMEZONE=America/Toronto
OMADA_DEFAULT_SCENARIO=Office

# Optional default device credentials for Omada site creation.
OMADA_DEVICE_USERNAME=admin
OMADA_DEVICE_PASSWORD=replace-with-device-password


# Centralized Zoho provider gateway.
# Reuse the existing CONNECTOR_API_KEY value from connect.opticable.ca as the
# server-to-server credential. Do not commit the value.
OPTICABLE_ZOHO_GATEWAY_URL=https://connect.opticable.ca
OPTICABLE_ZOHO_GATEWAY_API_KEY=
OPTICABLE_ZOHO_GATEWAY_TIMEOUT_SECONDS=60

# Optional Google Admin control plane.
# Create a Google OAuth 2.0 Web application client and use:
# https://api01.opticable.ca/v1/integrations/google/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api01.opticable.ca/v1/integrations/google/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/analytics.edit,https://www.googleapis.com/auth/analytics.readonly,https://www.googleapis.com/auth/tagmanager.readonly,https://www.googleapis.com/auth/tagmanager.edit.containers,https://www.googleapis.com/auth/tagmanager.delete.containers,https://www.googleapis.com/auth/tagmanager.edit.containerversions,https://www.googleapis.com/auth/tagmanager.publish,https://www.googleapis.com/auth/tagmanager.manage.accounts,https://www.googleapis.com/auth/tagmanager.manage.users
GOOGLE_OAUTH_CREDENTIALS_PATH=/var/lib/opticable-workflow-api/output/integrations/google-oauth.json
